# ReFrameAI environment template.
# Copy to .env and fill in: `cp .env.example .env`. NEVER commit .env.

# --- App ---
APP_SECRET_KEY=change-me-to-a-long-random-string
APP_ENV=development
BACKEND_PORT=8000
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000

# --- Database ---
# Local default (SQLite, zero-setup). For production use Postgres:
# DATABASE_URL=postgresql+psycopg://reframe:reframe@localhost:5432/reframe
DATABASE_URL=sqlite:///./data/reframe.db

# --- Redis / queue (optional for local dev; jobs run in-process without it) ---
REDIS_URL=redis://localhost:6379/0

# --- Meta Model API (https://dev.meta.ai) ---
# Single Bearer key used for SAM 3.1, Muse Spark and Muse Image.
MODEL_API_KEY=
MODEL_API_BASE=https://api.meta.ai/v1
SAM_MODEL=sam-3.1
SPARK_MODEL=muse-spark-1.3
IMAGE_MODEL=muse-image-1.0

# --- Object storage (optional; local filesystem is the default) ---
# When S3_ENDPOINT is empty, files are stored under ./data/storage.
S3_ENDPOINT=
S3_BUCKET=reframeai
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# --- Video limits ---
MAX_UPLOAD_MB=500
MAX_DURATION_SEC=600
STORAGE_DIR=./data/storage
